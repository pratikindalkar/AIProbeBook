@{
    ViewData["Title"] = "AI Probe Book Details";
}

<style>
    :root {
        --brand-purple: #8728E1;
        --border-color: #dce0e4;
        --text-dark: #444;
        --bg-light: #fdfdfd;
        --input-focus: rgba(135, 40, 225, 0.1);
    }

    /* Main container for the list */
    .prompt-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin: 20px 0;
    }

    /* Grid for each row: Label on left (180px), Input on right */
    .form-row {
        display: grid;
        grid-template-columns: 180px 1fr;
        align-items: center;
        gap: 15px;
    }

    .custom-label {
        font-weight: bold;
        color: var(--text-dark);
        font-size: 0.9rem;
    }

    .custom-select, .custom-txt {
        width: 30%; /* Keeps inputs at 30% width of the remaining space */
        padding: 10px 14px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.2s ease-in-out;
        background-color: var(--bg-light);
        color: #333;
    }

        .custom-select:focus, .custom-txt:focus {
            border-color: var(--brand-purple);
            box-shadow: 0 0 0 4px var(--input-focus);
            background-color: #fff;
        }

    .button-container {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-start;
        gap: 16px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #eee;
    }

    .custom-btn {
        padding: 12px 48px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        text-decoration: none;
    }

    .btn-save {
        background-color: var(--brand-purple);
        color: white;
    }

    .btn-cancel {
        background-color: #f8f9fa;
        color: #666;
        border: 1px solid #ddd;
    }

    /* --- Checkbox Styling --- */
    input[type="checkbox"] {
        width: 20px;
        height: 20px;
        accent-color: #8728E1; /* Matches your brand color */
        cursor: pointer;
        margin: 0;
    }
</style>

<form asp-action="GenerateAndDownloadLink" asp-controller="ChatWindowSetting" method="post">
    <div class="prompt-container">
        <div class="form-row">
            <label class="custom-label">Ai Model</label>
            <select class="custom-select" disabled>
                <option>--Select AI Model--</option>
                @if (ViewBag.ModelList is List<AILogBook.Models.AIModel> ModelList)
                {
                    foreach (var item in ModelList)
                    {
                        bool isSelected = (ViewBag.SelectedModelId != null && item.AutoId == (int)ViewBag.SelectedModelId);

                        <option value="@item.AutoId" selected="@(isSelected ? "selected" : null)">
                            @item.AIName
                        </option>
                    }
                }
            </select>
            <input type="hidden" name="Model_Id" value="@ViewBag.SelectedModelId" />
        </div>

        <div class="form-row">
            <label class="custom-label">Respondent Id</label>
            <input type="number" name="Respondent_Id" class="custom-txt" placeholder="1001" required />
        </div>

        <div class="form-row">
            <label class="custom-label">Project Key</label>
            <input type="text" id="txtProjectKey" class="custom-txt" readonly="readonly" placeholder="Enter details here" value="@ViewBag.ProjectKey" />
        </div>
        <input type="hidden" name="ProjectKey" value="@ViewBag.ProjectKey" />
        <input type="hidden" name="PromptId" value="@ViewBag.PromptId" />


        <div class="form-row">
            <label class="custom-label">No. Of Links</label>
            <div class="input-with-button">
                <input type="number" class="custom-txt" name="NoOfLinks" placeholder="Enter number" />

                <button type="submit" style="background:none; border:none; padding:0;">
                    <img src="~/images/downl.png" style="height:35px; width:35px; cursor: pointer;" title="Download Excel" />
                </button>
            </div>

        </div>

        <div class="button-container">
            <button type="submit"
                    asp-action="StartChatRedirect"
                    asp-controller="ChatWindowSetting"
                    formtarget="_blank"
                    class="custom-btn btn-save">
                Start Chat
            </button>

            <a asp-action="Main" asp-controller="Main" class="custom-btn btn-cancel">Cancel</a>
        </div>
    </div>
</form>
@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function() {
            alert('@TempData["Msg"]');
        };
    </script>
}
