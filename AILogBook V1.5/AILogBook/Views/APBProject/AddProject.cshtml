<script>
    document.addEventListener("DOMContentLoaded", function () {
        const fromInput = document.getElementById('fromDate');
        const toInput = document.getElementById('toDate');

        // format date to YYYY-MM-DD
        const formatDate = (date) => date.toISOString().split('T')[0];

        // Function to handle the "To Date" logic
        const handleDateConstraints = (fromDateValue, isNewRecord) => {
            if (!fromDateValue) return;

            // Ensure "To Date" cannot be physically selected before "From Date"
            toInput.setAttribute('min', fromDateValue);

            if (isNewRecord) {
                // Logic for Add New: Set To Date = From Date + 1 Month
                let date = new Date(fromDateValue);
                date.setMonth(date.getMonth() + 1);
                toInput.value = formatDate(date);
            } else {
                // Logic for Edit: If user changes From Date to be AFTER the current To Date,
                // fix the To Date so it's valid.
                if (toInput.value && toInput.value < fromDateValue) {
                    let date = new Date(fromDateValue);
                    date.setMonth(date.getMonth() + 1);
                    toInput.value = formatDate(date);
                }
            }
        };

        // --- INITIAL LOAD LOGIC ---
        if (!fromInput.value) {
            // 1. ADD NEW MODE: Field is empty
            const today = new Date();
            const todayStr = formatDate(today);

            fromInput.value = todayStr;
            handleDateConstraints(todayStr, true);
        } else {
            // 2. EDIT MODE: Field has database value
            handleDateConstraints(fromInput.value, false);
        }

        // --- CHANGE EVENT ---
        fromInput.addEventListener('change', function() {
            // When manually changed, we treat it like an edit to avoid
            // forcefully overwriting a To Date the user might want to keep
            handleDateConstraints(this.value, false);
        });
    });

</script>

@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function(){
            alert('@TempData["Msg"]');
        }
    </script>
}

