@{
    ViewData["Title"] = "Define Multiple Attribute";
}

<style>
    #myGrid thead th, #existingGrid thead th {
        background-color: #8728E1 !important;
        color: white !important;
        text-align: center;
        padding: 12px;
    }

    .custom-btn {
        border: none;
        padding: 10px 30px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-save {
        background-color: #8728E1;
        color: white;
    }

    .btn-cancel {
        background-color: #f8f9fa;
        color: #666;
        border: 1px solid #ddd;
        text-decoration: none;
    }
</style>

<table style="display:none;">
    <tbody id="rowTemplate">
        <tr>
            <td>
                <input type="text" name="attributeNames" class="form-control" placeholder="Enter Attribute Name" required />
            </td>
            <td>
                <div class="radio-group" style="display: flex; gap: 20px;">
                    <label><input type="radio" value="Positive" checked style="accent-color: #8728E1;"> Positive</label>
                    <label><input type="radio" value="Negative" style="accent-color: #8728E1;"> Negative</label>
                    <input type="hidden" name="attributeTypes" value="Positive" class="hidden-type" />
                </div>
            </td>
            <td class="text-center">
                <input type="checkbox" class="chk-active-ui" checked style="width:20px; height:20px;" />
                <input type="hidden" name="activeStatuses" value="1" />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-danger btn-sm remove-row"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
    </tbody>
</table>

<form asp-action="AddMultiAttribute" method="post" id="multiAttrForm">
    <div class="mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <select id="categorySelect"
                        name="CategoryId"
                        class="form-select"
                        style="width: 300px;"
                        required
                        asp-items="@(new SelectList(ViewBag.CateList, "AutoId", "CategoryName", ViewBag.SelectedCategoryId))">
                    <option value="0">-- Select Category --</option>
                </select>
            </div>
            <button type="button" id="addRowBtn" class="btn btn-link text-decoration-none text-dark">
                <i class="bi bi-plus-circle-fill" style="color: #8728E1;"></i> <b>Add Row</b>
            </button>
        </div>

        <table id="myGrid" class="table table-striped table-hover mt-3 w-100">
            <thead>
                <tr>
                    <th>Attribute Name</th>
                    <th>Type</th>
                    <th class="text-center">Active</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody id="gridBody">
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <button type="submit" class="custom-btn btn-save">Save All</button>
        <a asp-action="Attribute" class="custom-btn btn-cancel">Cancel</a>
    </div>
</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // 1. Determine Mode (Add vs Edit)
        var selectedId = '@ViewBag.SelectedCategoryId';

        if (selectedId && selectedId != '0' && selectedId != '') {
            // EDIT MODE
            $("#categorySelect").val(selectedId).prop("disabled", true);
            // Since disabled fields don't post, add a hidden field to carry the ID
            $("#multiAttrForm").append('<input type="hidden" name="CategoryId" value="' + selectedId + '" />');
            loadExistingAttributes(selectedId);
        } else {
            // ADD MODE
            $("#categorySelect").prop("disabled", false);
            addNewRow();
        }

        // 2. Event: Add Row Button
        $("#addRowBtn").click(function () {
            addNewRow();
        });

        // 3. Event: Category Dropdown Change (Only triggers in Add mode)
        $("#categorySelect").change(function () {
            var catId = $(this).val();
            if (catId != "0") {
                loadExistingAttributes(catId);
            } else {
                $("#gridBody").empty();
                addNewRow();
            }
        });

        // 4. Function: Add a blank row
        function addNewRow() {
            var html = $("#rowTemplate").html();
            var $newRow = $(html);

            // Unique name for radio buttons group per row to prevent selection overlap
            var uniqueName = "type_" + Date.now() + "_" + Math.floor(Math.random() * 1000);
            $newRow.find('input[type="radio"]').attr('name', uniqueName);

            $("#gridBody").append($newRow);
        }

        // 5. Function: Load existing data into the grid
        function loadExistingAttributes(id) {
            $.ajax({
                // url: '/Attribute/GetAttributesByCategory',
                url: '@Url.Action("GetAttributesByCategory", "Attribute")',
                type: 'GET',
                data: { id: id },
                success: function (data) {
                    $("#gridBody").empty();

                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            var $newRow = $($("#rowTemplate").html());

                            // Set radio group name
                            var uniqueName = "type_existing_" + item.autoId;
                            $newRow.find('input[type="radio"]').attr('name', uniqueName);

                            // Set Values
                            $newRow.find('input[name="attributeNames"]').val(item.attribute);
                            $newRow.find('input[type="radio"][value="' + item.type + '"]').prop('checked', true);
                            $newRow.find('.hidden-type').val(item.type);

                            // Set Checkbox
                            var isActive = (item.active == true || item.active == 1);
                            $newRow.find('.chk-active-ui').prop('checked', isActive);
                            $newRow.find('input[name="activeStatuses"]').val(isActive ? "1" : "0");

                            $("#gridBody").append($newRow);
                        });
                    } else {
                        addNewRow();
                    }
                },
                error: function() {
                    console.error("Failed to load attributes.");
                    if($("#gridBody tr").length === 0) addNewRow();
                }
            });
        }

        // 6. Event: Radio button change handler
        $(document).on('change', 'input[type="radio"]', function () {
            $(this).closest('td').find('.hidden-type').val($(this).val());
        });

        // 7. Event: Checkbox change handler
        $(document).on('change', '.chk-active-ui', function () {
            $(this).next('input[type="hidden"]').val($(this).is(':checked') ? "1" : "0");
        });

        // 8. Event: Remove Row
        $(document).on('click', '.remove-row', function () {
            if ($("#gridBody tr").length > 1) {
                $(this).closest('tr').remove();
            } else {
                alert("At least one row is required.");
            }
        });

        // 9. Validation before submit
        $("#multiAttrForm").submit(function(){
            // Enable dropdown temporarily so validation/value is read correctly,
            // though the hidden input we added handles the POST value.
            if($("#categorySelect").val() == "0"){
                alert("Please select a Category first.");
                return false;
            }
            return true;
        });
    });
</script>

@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function() {
            alert('@TempData["Msg"]');
        };
    </script>
}