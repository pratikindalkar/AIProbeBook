@model AILogBook.Models.PromptList;

@{
    ViewData["Title"] = "Main Page";
}
<style>
    /* GridView */
    #myGrid thead th {
        background-color: #8728E1 !important;
        color: white !important;
        border-color: #7221C1;
        vertical-align: middle;
        text-align: center;
    }
    /* Prevent rows from becoming too tall and manage prompt text */
    #myGrid td {
        vertical-align: middle;
        max-width: 300px;
        white-space: normal;
        word-break: break-word;
        font-size: 0.9rem;
    }

    /* Specific width for Prompt columns */
    .col-prompt {
        min-width: 200px;
        width: 500px;
    }

    .dataTables_scrollHead thead th {
        background-color: #8728E1 !important; /* Your Purple Color */
        color: white !important;
        vertical-align: middle;
        text-align: center;
    }

    /* Ensure the header container itself doesn't have a white background */
    .dataTables_scrollHead {
        background-color: #8728E1 !important;
    }

    .button-container {
        display: flex;
        justify-content: flex-start;
        gap: 15px;
        width: 100%;
        max-width: 415px;
        margin-top: 30px;
        padding-left: 165px;
    }


    /* Container for the whole filter row */
    .filter-wrapper {
        background: #fcfaff; /* Very light purple tint */
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #eee;
        margin-bottom: 25px;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end; /* Aligns button with the bottom of dropdowns */
        gap: 20px;
    }

    /* Individual Filter Group */
    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .filter-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #555;
            margin-bottom: 0;
        }

        /* Consistent Dropdown Styling */
        .filter-group .custom-select {
            height: 40px;
            width: 220px; /* Uniform width */
            padding: 5px 12px;
            border: 1px solid #dce0e4;
            border-radius: 6px;
            background-color: #fff;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s;
        }

            .filter-group .custom-select:focus {
                border-color: #8728E1;
            }

    /* Button override for perfect height match */
    .btn-apply {
        height: 40px;
        padding: 0 30px;
        background-color: #8728E1;
        color: white;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-apply:hover {
            background-color: #7221C1;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(135, 40, 225, 0.2);
        }
</style>
<form asp-action="Main" method="get">
    <div class="filter-wrapper">
        <div class="filter-group">
            <label class="custom-label">
                Category
                <select name="Cate" class="custom-select">
                    <option value="">-- Select Categories --</option>
                    @if (ViewBag.CateList is List<AILogBook.Models.Categories> CateList)
                    {
                        foreach (var item in CateList)
                        {
                            <option value="@item.AutoId" selected="@(item.AutoId.ToString() == ViewBag.SelectedCate?.ToString())">
                                @item.CategoryName
                            </option>
                        }
                    }
                </select>
            </label>
        </div>

        <div class="filter-group">
            <label class="custom-label">
                Rating
                <select name="Rate" class="custom-select">
                    <option value="">-- Select Rating --</option>
                    @for (int i = 10; i >= 1; i--)
                    {
                        string label = i == 1 ? "(Worst)" : (i == 10 ? "(Best)" : "");
                        <option value="@i" selected="@(i.ToString() == ViewBag.SelectedRate?.ToString())">
                            @i @label
                        </option>
                    }
                </select>
            </label>
        </div>

        <div class="filter-group">
            <button type="submit" class="btn-apply">
                <i class="fas fa-filter"></i> Apply Filters
            </button>
        </div>
        <div class="filter-group">
            <button type="submit" class="btn-apply" asp-action="Reset" asp-controller="Main">
                <i class="fas fa-undo"></i> Reset
            </button>
        </div>
    </div>
</form>

<div class="d-flex justify-content-end mt-3 pe-2 gap-3">
    <a asp-action="PromptView" asp-controller="Main" class="text-decoration-none" title="Add Prompt">
        <img src="~/images/add.png" alt="Add" style="height:25px; width:25px;" />
        <span class="custom-label" style="cursor:pointer;">Prompt</span>
    </a>
    <a asp-action="Download" asp-controller="Main" class="text-decoration-none">
        <img src="~/images/excel.png" alt="Download" style="height:25px; width:25px;" />
        <span class="custom-label" style="cursor:pointer;">Download</span>
    </a>
</div>


<table id="myGrid" class="table table-striped table-hover mt-3 w-100">
    <thead>
        <tr>
            <th>Download</th>
            <th>Chat</th>
            <th>SaveAs</th>
            <th>Edit</th>
            <th>Delete</th>
            <th>AutoId</th>
            <th class="col-prompt">Final Prompt</th>
            <th>Category</th>
            <th>Topic</th>
            <th>Count</th>
            <th>Chars</th>
            <th>Words</th>
            <th>Rating</th>
            <th>User</th>
            <th>Date</th>
            <th>Time</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.PromptList != null)
        {
            var result = ViewBag.PromptList as List<AILogBook.Models.PromptList>;
            foreach (var item in result)
            {
                <tr>
                    <td>
                        <a asp-action="DownloadConversation" asp-controller="Main" asp-route-id="@item.AutoID" class="btn p-0" title="Download Conversation">
                            <img src="~/images/downl.png" style="height:30px; width:30px;" />
                        </a>
                    </td>
                    <td class="text-center">
                        @* <a href="/AiChat/Index?id=@item.AutoID" target="_blank" class="btn btn-primary" style="background:none; border:none">
                            <img src="~/images/Chat.png" style="height:25px; width:25px;" />
                        </a> *@
                        <a asp-action="ChatWindow" asp-controller="ChatWindowSetting" asp-route-id="@item.AutoID" title="Start Chat">
                            <img src="~/images/Chat.png" style="height:25px; width:25px;" />
                        </a>
                    </td>
                    <td class="text-center">
                        <a asp-action="SaveAs" asp-route-id="@item.AutoID" title="Create a Copy">
                            <img src="~/images/saveAs.png" style="height:35px; width:35px;" />
                        </a>
                    </td>
                    <td class="text-center">
                        <a asp-action="EditPrompt" asp-route-id="@item.AutoID" title="Edit Prompt">
                            <img src="~/images/edit.png" style="height:25px; width:25px;" />
                        </a>
                    </td>
                    <td class="text-center">
                        <a asp-action="DeletePrompt" asp-route-id="@item.AutoID" title="Delete Prompt"
                           onclick="return confirm('Are you sure you want to delete this prompt?');">
                            <img src="~/images/delete.png" style="height:25px; width:25px;" />
                        </a>
                    </td>
                    <td>@item.AutoID</td>
                    <td title="@item.FinalPrompt">@(item.FinalPrompt?.Length > 30 ? item.FinalPrompt.Substring(0, 30) + "..." : item.FinalPrompt)</td>
                    <td>@item.CategoryName</td>
                    <td>@item.ShortTopic</td>
                    <td>@item.Count</td>
                    <td>@item.CharCountPrompt</td>
                    <td>@item.WordCountPrompt</td>
                    @* <td>@item.FinalPrompt</td> *@
                    <td>@item.Rating</td>
                    <td>@item.UpdatedUser</td>
                    <td>@item.UpdatedDate</td>
                    <td>@item.UpdatedTime</td>
                    <td>
                        <span class="badge @(item.Active ? "bg-success" : "bg-danger")">
                            @(item.Active ? "Active" : "Inactive")
                        </span>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <script type="text/javascript">
                        $(document).ready(function () {
            var table = $('#myGrid').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true,
                "pageLength": 25,
                "scrollX": true,
                "autoWidth": false,
                "order": [[4, 'desc']], // <--- SET DEFAULT SORT TO AUTOID (Index 2)
                "columnDefs": [
                    {
                        "orderable": false,
                        "targets": [0, 1, 2, 3], // Disable sorting on Edit and Delete
                        "width": "45px",
                        "className": "text-center"
                    }
                ],
                "language": {
                    "emptyTable": "No records found matching your search."
                }
            });
        });
    </script>
}
@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function(){
            alert('@TempData["Msg"]');
        }
    </script>
}
