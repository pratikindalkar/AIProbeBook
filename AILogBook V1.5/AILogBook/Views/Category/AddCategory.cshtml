@model AILogBook.Models.Categories;
@{
    ViewData["Title"] = "Define Categories";
}


<style>
    /* Container for each Label + Dropdown row */
    .form-row {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        gap: 45px;
        flex-wrap: wrap;
    }

    .custom-label {
        min-width: 120px;
        font-weight: bold;
        white-space: nowrap;
        color: #444;
    }

    .custom-select, .custom-txt {
        flex: 1;
        max-width: 250px;
        height: 50px;
        /* padding: 8px 12px; */
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .custom-select:focus, .custom-txt:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15);
        }


    .button-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 80%;
        margin-top: 30px;
    }

    .custom-btn {
        background-color: #8728E1;
        color: white;
        /* min-width: 100px;  */
        padding: 8px 30px;
        border-radius: 8px;
    }

        /* --- Checkbox Styling --- */
        input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: #8728E1; /* Matches your brand color */
            cursor: pointer;
            margin: 0;
        }

    /* --- Button Styling --- */
    .button-container {
        display: flex;
        justify-content: flex-start; 
        gap: 15px; 
        width: 100%;
        max-width: 415px; 
        margin-top: 30px;
        padding-left: 165px; 
    }

    .custom-btn {
        border: none;
        padding: 10px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    /* Save Button */
    .btn-save {
        background-color: #8728E1;
        color: white;
        box-shadow: 0 4px 12px rgba(135, 40, 225, 0.2);
    }

        .btn-save:hover {
            background-color: #6a1eb3;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(135, 40, 225, 0.3);
        }

    /* Cancel Button */
    .btn-cancel {
        background-color: #f8f9fa;
        color: #666;
        border: 1px solid #ddd;
    }

        .btn-cancel:hover {
            background-color: #e9ecef;
            color: #333;
        }
</style>
<form asp-action="@(Model?.AutoId > 0 ? "EditCategory" : "AddCategory")" asp-controller="Category" method="post">
    <input type="hidden" asp-for="AutoId" />

    <div class="form-row textarea-row">
        <label class="custom-label">Category Name</label>
@*<textarea asp-for="CategoryName" class="custom-txt"></textarea>*@
        <input type="text" asp-for="CategoryName" class="custom-txt" placeholder="Enter category name" /><span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>

    <div class="form-row">
        <label class="custom-label">Active</label>
        <input type="checkbox" checked="checked" asp-for="Active" />
    </div>

    <div class="button-container">
        <button type="submit" class="custom-btn btn-save">Save</button>
        <a asp-action="Index" class="custom-btn btn-cancel">Cancel</a>
    </div>
</form>

@if(TempData["Msg"] != null)
{
    <script>
        window.onload = function(){
            alert('@TempData["Msg"]');
        }
    </script>
}
