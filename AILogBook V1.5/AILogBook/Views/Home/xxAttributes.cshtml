@{
    ViewData["Title"] = "Attribute";
}
<style>
    /* GridView */
    #myGrid thead th {
        background-color: #8728E1 !important;
        color: white !important;
        border-color: #7221C1;
        vertical-align: middle;
        text-align: center;
    }
    .dataTables_scrollHead thead th {
        background-color: #8728E1 !important; 
        color: white !important;
        vertical-align: middle;
        text-align: center;
    }

    .dataTables_scrollHead {
        background-color: #8728E1 !important;
    }
</style>
<div>
    <table id="myGrid" class="table table-striped table-hover mt-3 w-100">
        <thead>
            <tr>
                <th>Edit</th>
                <th>Delete</th>
                <th>AutoID</th>
                <th>CategoryID</th>
                <th>Attribute</th>
                <th>Type</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.AttrList != null)
            {
                var result = ViewBag.AttrList as List<AILogBook.Models.Attributes>;
                for (int i = 0; i < result.Count; i++)
                {
                    <tr>
                        <td>
                            <a asp-action="EditAttribute" asp-route-id="@result[i].AutoId" class="btn p-0">
                                <img src="~/images/edit.png" style="height:30px; width:30px;" />
                            </a>
                        </td>
                        <td>
                            <a asp-action="DeleteAttribute" asp-controller="Home" asp-route-id="@result[i].AutoId"
                               class="btn btn-sm btn-icon-only p-0" onclick="return confirm('Are you sure you want to delete this attribute?');">
                                <img src="~/images/delete.png" alt="Delete" style="height:30px; width:30px;" />
                            </a>
                        </td>
                        <td>@result[i].AutoId</td>
                        <td>@result[i].CategoryId</td>
                        <td>@result[i].Attribute</td>
                        <td>@result[i].Type</td>
                        <td>
                            <span class="badge @(result[i].Active ? "bg-success" : "bg-danger")">
                                @(result[i].Active ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <script type="text/javascript">
                        $(document).ready(function () {
            var table = $('#myGrid').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true,
                "pageLength": 25,
                "scrollX": true,
                "autoWidth": false,
                "order": [[2, 'asc']], // <--- SET DEFAULT SORT TO AUTOID (Index 2)
                "columnDefs": [
                    {
                        "orderable": false,
                        "targets": [0, 1], // Disable sorting on Edit and Delete
                        "width": "45px",
                        "className": "text-center"
                    }
                ],
                "language": {
                    "emptyTable": "No records found matching your search."
                }
            });
        });
    </script>
}
@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function(){
            alert("@TempData["Msg"]");
        }
    </script>
}