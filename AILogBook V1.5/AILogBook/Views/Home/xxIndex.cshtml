@model AILogBook.Models.PromptList

@{
    ViewData["Title"] = "Main Page";
}
<style>
    /* DropDown */
    .inline-form-group {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .custom-label {
        font-weight: bold;
        white-space: nowrap;
        color: #444;
    }

    .custom-select {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        width: 225px;
    }

    /* Search button */
    .custom-btn {
        background-color: #8728E1;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        white-space: nowrap;
        transition: background-color 0.2s;
    }

        .custom-btn:hover {
            background-color: #7221C1;
        }
    /* GridView */
    #myGrid thead th {
        background-color: #8728E1 !important;
        color: white !important;
        border-color: #7221C1;
        vertical-align: middle;
        text-align: center;
    }

    .dataTables_scrollHead thead th {
        background-color: #8728E1 !important; /* Your Purple Color */
        color: white !important;
        vertical-align: middle;
        text-align: center;
    }

    /* Ensure the header container itself doesn't have a white background */
    .dataTables_scrollHead {
        background-color: #8728E1 !important;
    }
</style>

<form asp-action="Index" method="get">
    <div class="inline-form-group">
        <label class="custom-label">Select Model</label>
        <select name="SelectedModelName" class="custom-select">
            <option value="">-- Select AI Model --</option>
            @{
                var ModelList = ViewBag.ModelList as List<AILogBook.Models.AIModel>;
                if (ModelList != null)
                {
                    for (int i = 0; i < ModelList.Count; i++)
                    {
                        <option value="@ModelList[i].AIName">@ModelList[i].AIName</option>
                    }
                }
            }
        </select>

        <label class="custom-label">Select Categories</label>
        <select name="SelectedCateName" class="custom-select">
            <option value="">-- Select Categories --</option>
            @{
                var CateList = ViewBag.CateList as List<AILogBook.Models.Categories>;
                if (CateList != null)
                {
                    for (int i = 0; i < CateList.Count; i++)
                    {
                        <option value="@CateList[i].CategoryName">@CateList[i].CategoryName</option>
                    }
                }
            }
        </select>
        <button type="submit" formmethod="get" class="custom-btn">Search</button>
    </div>
</form>
<br />
<br />

<div>
    <table id="myGrid" class="table table-striped table-hover mt-3 w-100">
        <thead>
            <tr>
                <th>Chat</th>
                <th>View</th>
                <th>SrNo</th>
                <th>ModelName</th>
                <th>CategoryId</th>
                <th>Categories</th>
                <th>TopicId</th>
                <th>Topic</th>
                <th>AttributeID</th>
                <th>Attribute</th>
                <th>Type</th>
                <th>FinalPrompt</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.MainModelList != null)
            {
                var result = ViewBag.MainModelList as List<AILogBook.Models.PromptList>;
                for (int i = 0; i < result.Count; i++)
                {
                    <tr>
                        <td>
                            <a asp-action="PromptView" class="btn btn-sm btn-icon-only">
                                <img src="~/images/Chat.png" alt="Start Chat" style="height:20px; width:20px; background:transparent;" />
                            </a>
                        </td>
                        <td>
                            <a asp-action="PromptView" class="btn btn-sm btn-icon-only">
                                <img src="~/images/View.png" alt="View" style="height:20px; width:20px;" />
                            </a>
                        </td>
                       @*  <td>@result[i].SrNo</td>
                        <td>@result[i].ModelName</td>
                        <td>@result[i].CategoryId</td>
                        <td>@result[i].Categories</td>
                        <td>@result[i].TopicId</td>
                        <td>@result[i].Topic</td>
                        <td>@result[i].AttributeId</td>
                        <td>@result[i].Attribute</td>
                        <td>@result[i].Type</td> *@
                        <td>@result[i].FinalPrompt</td>
                        <td>
                            <span class="badge @(result[i].Active ? "bg-success" : "bg-danger")">
                                @(result[i].Active ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <script type="text/javascript">
                $(document).ready(function () {
            var table = $('#myGrid').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true,
                "pageLength": 25,
                "scrollX": true,
                "autoWidth": false,
                "columnDefs": [
                    { "orderable": false, "targets": [0, 1] },
                    { "width": "150px", "targets": [0, 1] }
                ],
                "language": {
                    "emptyTable": "No records found matching your search."
                }
            });
        });
    </script>
}
