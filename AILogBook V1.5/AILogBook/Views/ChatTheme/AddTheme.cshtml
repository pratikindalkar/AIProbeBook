    <div class="form-group-row">
        <label class="custom-label">isTimer</label>
        <input type="checkbox" asp-for="isTimer" />
    </div>
    <div class="form-group-row">
        <label class="custom-label">Active</label>
        <input type="checkbox" checked="checked" asp-for="Active" />
    </div>

    <div class="button-container">
        <button type="submit" class="custom-btn btn-save">Save</button>
        <a asp-action="ChatTheme" class="custom-btn btn-cancel">Cancel</a>
    </div>
</form>


@if (TempData["Msg"] != null)
