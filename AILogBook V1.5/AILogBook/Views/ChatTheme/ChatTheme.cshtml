@{
    ViewData["Title"] = "Chat Settings";
}
<style>
    .custom-label {
        font-weight: bold;
        white-space: nowrap;
        color: #444;
    }

    /* GridView */
    #myGrid thead th {
        background-color: #8728E1 !important;
        color: white !important;
        border-color: #7221C1;
        vertical-align: middle;
        text-align: center;
    }

    .dataTables_scrollHead thead th {
        background-color: #8728E1 !important;
        color: white !important;
        vertical-align: middle;
        text-align: center;
    }

    .dataTables_scrollHead {
        background-color: #8728E1 !important;
    }

    /* Card Base Styling */
    .custom-card {
        border: none;
        border-radius: 15px;
        background: #ffffff;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .custom-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(135, 40, 225, 0.1);
        }

    /* Borders for specific cards */
    .border-purple {
        border-bottom: 5px solid #8728E1 !important;
    }

    .border-green {
        border-bottom: 5px solid #2ecc71 !important;
    }

    /* Stat Titles & Numbers */
    .stat-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 10px;
    }

    .stat-number {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 0;
    }

    .text-purple {
        color: #8728E1;
    }

    .text-green {
        color: #2ecc71;
    }
</style>

<div class="d-flex justify-content-end mt-3 pe-2 gap-3">
    <a asp-action="AddTheme" asp-controller="ChatTheme" class="text-decoration-none" title="Add Theme">
        <img src="~/images/add.png" alt="Add" style="height:25px; width:25px;" />
        <span class="custom-label" style="cursor:pointer;">Theme</span>
    </a>
@*     <a asp-action="Download" asp-controller="Topic" class="text-decoration-none">
        <img src="~/images/excel.png" alt="Download" style="height:25px; width:25px;" />
        <span class="custom-label" style="cursor:pointer;">Download</span>
    </a> *@
</div>
<table id="myGrid" class="table table-striped table-hover mt-3 w-100">
    <thead>
        <tr>
            <th>Edit</th>
            <th>Delete</th>
            <th>AutoId</th>
            <th>ThemeName</th>
            <th>ChatTitle</th>
            <th>VKSLogofile</th>
            <th>AI Icon</th>
            <th>Resp Icon</th>
            <th>Background Img</th>
            <th>Chat Wait</th>
            <th>isTimer</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.ThemeList != null)
        {
            var ThemeData = ViewBag.ThemeList as List<AILogBook.Models.ChatSettings>;
            foreach (var theme in ThemeData)
            {
                <tr>
                    <td class="text-center">
                        <a asp-action="EditTheme" asp-route-id="@theme.AutoId" title="Edit Theme">
                            <img src="~/images/edit.png" style="height:25px; width:25px;" />
                        </a>
                    </td>
                    <td class="text-center">
                        <a asp-action="DeleteTheme" asp-route-id="@theme.AutoId" title="Delete Theme"
                           onclick="return confirm('Are you sure you want to delete this Theme?');">
                            <img src="~/images/delete.png" style="height:25px; width:25px;" />
                        </a>
                    </td>
                    <td>@theme.AutoId</td>
                    <td>@theme.ThemeName</td>
                    <td>@theme.ChatTitle</td>
                    <td title="@theme.VKSLogofile">@(theme.VKSLogofile?.Length > 30 ? theme.VKSLogofile.Substring(0, 30) + "..." : theme.VKSLogofile)</td>
                    <td title="@theme.AI_Icon">@(theme.AI_Icon?.Length > 30 ? theme.AI_Icon.Substring(0, 30) + "..." : theme.AI_Icon)</td>
                    <td title="@theme.Resp_Icon">@(theme.Resp_Icon?.Length > 30 ? theme.Resp_Icon.Substring(0, 30) + "..." : theme.Resp_Icon)</td>
                    <td title="@theme.Background_Img">@(theme.Background_Img?.Length > 30 ? theme.Background_Img.Substring(0, 30) + "..." : theme.Background_Img)</td>
                    <td>@theme.ChatWaitTimer</td>
                    <td>
                        <span class="badge @(theme.isTimer ? "bg-success" : "bg-danger")">
                            @(theme.isTimer ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <span class="badge @(theme.Active ? "bg-success" : "bg-danger")">
                            @(theme.Active ? "Active" : "Inactive")
                        </span>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <script type="text/javascript">
                        $(document).ready(function () {
            var table = $('#myGrid').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true,
                "pageLength": 25,
                "scrollX": true,
                "autoWidth": false,
                "order": [[2, 'asc']], // <--- SET DEFAULT SORT TO AUTOID (Index 2)
                "columnDefs": [
                    {
                        "orderable": false,
                        "targets": [0, 1], // Disable sorting on Edit and Delete
                        "width": "45px",
                        "className": "text-center"
                    }
                ],
                "language": {
                    "emptyTable": "No records found matching your search."
                }
            });
        });
    </script>
}
@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function(){
            alert("@TempData["Msg"]");
        }
    </script>
}
