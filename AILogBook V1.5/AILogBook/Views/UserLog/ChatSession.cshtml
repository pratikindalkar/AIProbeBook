@{
    ViewData["Title"] = "Chat Session";
}
<style>
    .custom-label {
        font-weight: bold;
        white-space: nowrap;
        color: #444;
    }

    /* GridView */
    #myGrid thead th {
        background-color: #8728E1 !important;
        color: white !important;
        border-color: #7221C1;
        vertical-align: middle;
        text-align: center;
    }

    .dataTables_scrollHead thead th {
        background-color: #8728E1 !important;
        color: white !important;
        vertical-align: middle;
        text-align: center;
    }

    .dataTables_scrollHead {
        background-color: #8728E1 !important;
    }
</style>

<table id="myGrid" class="table table-striped table-hover mt-3 w-100">
    <thead>
        <tr>
            <th>Download</th>
            <th>AutoID</th>
            <th>Respondent_Id</th>
            <th>ProjectCode</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Date</th>
            <th>Category</th>
            <th>Topic</th>
            <th>Prompt_Id</th>
            <th>Rating</th>
            <th>FinalPrompt</th>
            <th>Usable</th>
            <th>SelfEnded</th>
            <th>Remarks</th>
            <th>Model_Id</th>
            <th>TotalWordCount</th>
            <th>TotalCharCount</th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.chatSession != null)
        {
            var result = ViewBag.chatSession as List<AILogBook.Models.ChatSession>;
            for (int i = 0; i < result.Count; i++)
            {
                <tr>
                    <td class="text-center">
                        <a asp-action="DownloadChatSession" asp-route-id="@result[i].AutoId" title="Download Chat">
                            <img src="~/images/downl.png" style="height:25px; width:25px;" />
                        </a>
                    </td>
                    <td>@result[i].AutoId</td>
                    <td>@result[i].Respondent_Id</td>
                    <td>@result[i].ProjectCode</td>
                    <td>@result[i].Start_Time</td>
                    <td>@result[i].End_Time</td>
                    <td>@result[i].Date.ToString("yyyy-MM-dd")</td>
                    <td>@result[i].Category</td>
                    <td>@result[i].Topic</td>
                    <td>@result[i].Prompt_Id</td>
                    <td>@result[i].Rating</td>
                    <td title="@result[i].FinalPrompt">@(result[i].FinalPrompt?.Length > 30 ? result[i].FinalPrompt.Substring(0, 30) + "..." : result[i].FinalPrompt)</td>
                    <td>@result[i].Usable</td>
                    <td>@result[i].SelfEnded</td>
                    <td>@result[i].Remarks</td>
                    <td>@result[i].Model_Id</td>
                    <td>@result[i].TotalWordCount</td>
                    <td>@result[i].TotalCharCount</td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <script type="text/javascript">
                        $(document).ready(function () {
            var table = $('#myGrid').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true,
                "pageLength": 25,
                "scrollX": true,
                "autoWidth": false,
                "order": [[0, 'desc']], // <--- SET DEFAULT SORT TO AUTOID (Index 2)
                "columnDefs": [
                    {
                        "orderable": false,
                        "targets": [0, 1], // Disable sorting on Edit and Delete
                        "width": "45px",
                        "className": "text-center"
                    }
                ],
                "language": {
                    "emptyTable": "No records found matching your search."
                }
            });
        });
    </script>
}
@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function(){
            alert("@TempData["Msg"]");
        }
    </script>
}