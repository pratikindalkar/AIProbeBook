@{
	ViewData["Title"] = "User Master";
}

<style>

	.custom-label {
		font-weight: bold;
		white-space: nowrap;
		color: #444;
	}
	/* GridView */
	#myGrid thead th {
		background-color: #8728E1 !important;
		color: white !important;
		border-color: #7221C1;
		vertical-align: middle;
		text-align: center;
	}

	.dataTables_scrollHead thead th {
		background-color: #8728E1 !important;
		color: white !important;
		vertical-align: middle;
		text-align: center;
	}

	.dataTables_scrollHead {
		background-color: #8728E1 !important;
	}

	/* Card Base Styling */
	.custom-card {
		border: none;
		border-radius: 15px;
		background: #ffffff;
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

		.custom-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 15px 30px rgba(135, 40, 225, 0.1);
		}

	/* Borders for specific cards */
	.border-purple {
		border-bottom: 5px solid #8728E1 !important;
	}

	.border-green {
		border-bottom: 5px solid #2ecc71 !important;
	}

	/* Stat Titles & Numbers */
	.stat-title {
		font-size: 0.85rem;
		font-weight: 600;
		color: #888;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-top: 10px;
	}

	.stat-number {
		font-size: 2.2rem;
		font-weight: 800;
		margin-bottom: 0;
	}

	.text-purple {
		color: #8728E1;
	}

	.text-green {
		color: #2ecc71;
	}
</style>
<div>
	<table id="myGrid" class="table table-striped table-hover mt-3 w-100">
		<thead>
			<tr>
				<th>Auto Id</th>
				<th>User Name</th>
				<th>Module</th>
				<th>Category</th>
				<th>Topic ID</th>
				<th>Session Created</th>
				<th>Date</th>
				<th>Time</th>
			</tr>
		</thead>
		<tbody>
			@if (ViewBag.Data != null)
			{
				//var result = ViewBag.CateList as List<AILogBook.Models.Categories>;
				@foreach (var item in ViewBag.Data)
				{
					<tr>
						<td>@item.Auto_Id</td>
						<td>@item.Login_Name</td>
						<td>@item.Module</td>
						<td>@item.Category</td>
						<td>@item.Topic_id</td>
						<td>@item.Session_created</td>
						<td>@Convert.ToDateTime(item.Date).ToString("dd-MM-yyyy")</td>
						<td>@item.Time</td>
					</tr>
				}
			}
		</tbody>
	</table>
</div>

@section Scripts {
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
	<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

	<script type="text/javascript">
						$(document).ready(function () {
			var table = $('#myGrid').DataTable({
				"paging": true,
				"ordering": true,
				"info": true,
				"searching": true,
				"pageLength": 25,
				"scrollX": true,
				"autoWidth": false,
				"order": [[0, 'asc']],
				"columnDefs": [
					{
						"orderable": false,
						"width": "45px",
						"className": "text-center"
					}
				],
				"language": {
					"emptyTable": "No records found matching your search."
				}
			});
		});
	</script>
}

