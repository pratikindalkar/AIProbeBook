@{
    ViewData["Title"] = "Chat Conversation";
}
<style>
    .custom-label {
        font-weight: bold;
        white-space: nowrap;
        color: #444;
    }

    /* GridView */
    #myGrid thead th {
        background-color: #8728E1 !important;
        color: white !important;
        border-color: #7221C1;
        vertical-align: middle;
        text-align: center;
    }

    .dataTables_scrollHead thead th {
        background-color: #8728E1 !important;
        color: white !important;
        vertical-align: middle;
        text-align: center;
    }

    .dataTables_scrollHead {
        background-color: #8728E1 !important;
    }
</style>

