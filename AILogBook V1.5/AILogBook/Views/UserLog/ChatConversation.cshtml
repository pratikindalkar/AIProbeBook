<table id="myGrid" class="table table-striped table-hover mt-3 w-100">
    <thead>
        <tr>
            @* <th>Edit</th> *@
            @* <th>Download</th>  *@
            <th>AutoID</th>
            <th>ChatSession_id</th>
            <th>Prompt_id</th>
            <th>Chat_id</th>
            <th>Respondent_Id</th>
            <th>Question</th>
            <th>UserResponse</th>
            <th>ProjectCode</th>
            <th>Modelid</th>
            <th>CreatedDate</th>
            <th>CreatedTime</th>
            <th>QuestionWordCount</th>
            <th>QuestionCharCount</th>
            <th>ResponseWordCount</th>
            <th>ResponseCharCount</th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.ChatConversation != null)
        {
            var result = ViewBag.ChatConversation as List<AILogBook.Models.ChatConversation>;
            for (int i = 0; i < result.Count; i++)
            {
                <tr>
                    <td>@result[i].AutoId</td>
                    <td>@result[i].ChatSession_id</td>
                    <td>@result[i].Prompt_id</td>
                    <td>@result[i].Chat_id</td>
                    <td>@result[i].Respondent_id</td>
                    <td>@result[i].Question</td>
                    <td>@result[i].UserResponse</td>
                    <td>@result[i].ProjectCode</td>
                    <td>@result[i].ModelId</td>
                    <td>@($"{result[i].CreatedDate:d}")</td>
                    <td>@result[i].CreatedTime</td>
                    <td>@result[i].QuestionWordCount</td>
                    <td>@result[i].QuestionCharCount</td>
                    <td>@result[i].ResponseWordCount</td>
                    <td>@result[i].ResponseCharCount</td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <script type="text/javascript">
                        $(document).ready(function () {
            var table = $('#myGrid').DataTable({
                "paging": true,
                "ordering": true,
                "info": true,
                "searching": true,
                "pageLength": 25,
                "scrollX": true,
                "autoWidth": false,
                "order": [[0, 'desc']], // <--- SET DEFAULT SORT TO AUTOID (Index 2)
                "columnDefs": [
                    {
                        "orderable": false,
                        "targets": [0, 1], // Disable sorting on Edit and Delete
                        "width": "45px",
                        "className": "text-center"
                    }
                ],
                "language": {
                    "emptyTable": "No records found matching your search."
                }
            });
        });
    </script>
}
@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function(){
            alert("@TempData["Msg"]");
        }
    </script>
}