@model AILogBook.Models.Topics;
@{
    ViewData["Title"] = "Add Topic";
}
<style>
    /* Container for each Label + Dropdown row */
    .form-row {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        gap: 45px;
        flex-wrap: wrap;
    }

    .custom-label {
        min-width: 120px;
        font-weight: bold;
        white-space: nowrap;
        color: #444;
    }
    /* --- Checkbox Styling --- */
    input[type="checkbox"] {
        width: 20px;
        height: 20px;
        accent-color: #8728E1; /* Matches your brand color */
        cursor: pointer;
        margin: 0;
    }

    .custom-select, .custom-txt {
        flex: 1;
        max-width: 250px;
        /* padding: 8px 12px; */
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .custom-select:focus, .custom-txt:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15);
        }
    /* Save Button */
    .button-container {
        display: flex;
        justify-content: flex-start; /* Align with your input fields */
        gap: 15px; /* Space between Save and Cancel */
        width: 100%;
        max-width: 415px; /* Matches label (120px) + gap (45px) + input (250px) */
        margin-top: 30px;
        padding-left: 165px; /* Aligns buttons under the textareas */
    }

    .custom-btn {
        border: none;
        padding: 10px 30px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
    }


    .btn-save {
        background-color: #8728E1;
        color: white;
        box-shadow: 0 4px 12px rgba(135, 40, 225, 0.2);
    }

        .btn-save:hover {
            background-color: #6a1eb3;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(135, 40, 225, 0.3);
        }

    /* Cancel Button */
    .btn-cancel {
        background-color: #f8f9fa;
        color: #666;
        border: 1px solid #ddd;
    }

        .btn-cancel:hover {
            background-color: #e9ecef;
            color: #333;
        }
</style>
<form asp-action="@(Model?.AutoId > 0 ? "EditTopic" : "AddTopic")" method="post">
    <input type="hidden" asp-for="AutoId" />
    <div class="form-row textarea-row">
        <label class="custom-label">Topic</label>
        <textarea asp-for="Topic" class="custom-txt"></textarea>
        <span asp-validation-for="Topic" class="text-danger"></span>
    </div>
    <div class="form-row textarea-row">
        <label class="custom-label">Short Topic</label>
        <textarea asp-for="ShortTopic" class="custom-txt"></textarea>
        <span asp-validation-for="ShortTopic" class="text-danger"></span>
    </div>
    <div class="form-row">
        <label class="custom-label">Active</label>
        <input type="checkbox" checked="checked" asp-for="Active" />
    </div>
    <div class="button-container">
        <button type="submit" class="custom-btn btn-save">Save</button>
        <a asp-action="Topic" class="custom-btn btn-cancel">Cancel</a>
    </div>
</form>
@if (TempData["Msg"] != null)
{
    <script>
        window.onload = function(){
            alert("@TempData["Msg"]");
        }
    </script>
}